# ─── Aptitude-AI Environment Variables ────────────────────────────────────────

# Groq API Key - Get yours from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace token (optional — for private models) - Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Data directories (override defaults in config.yaml)
# PDF_DIR=data/raw/pdfs
# DATASET_DIR=data/raw/datasets
# VECTOR_STORE_DIR=vector_store/faiss_index

# Set to "true" to skip BERT validation (faster, useful during development)
SKIP_VALIDATION=false


LOG_LEVEL=INFO
